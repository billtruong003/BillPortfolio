# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Unity WebGL output is deployed to Cloudflare R2.
/public/webgl-games/*/Build/
/public/webgl-games/*/StreamingAssets/
/public/webgl-games/zombie-war/Build/
/public/webgl-games/zombie-war/StreamingAssets/
/public/webgl-games/zombie-war/TemplateData/
/public/webgl-games/zombie-war/index.html

# Large media is deployed to Cloudflare R2; optimized WebP covers stay in Git.
/public/image/life/*.mp4

# Generated by scripts/compile-posts.mjs (prebuild / predev)
/data/posts.json

# Generated by scripts/compile-posts.mjs
/public/lab/feed.xml

# VS Code Local History
.lh/
